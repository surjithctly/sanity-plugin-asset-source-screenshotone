{
  "name": "sanity-plugin-asset-source-screenshotone",
  "version": "2.0.0",
  "description": "Sanity Plugin to generate Screenshots from URL",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "sanity.json", "src", "v2-incompatible.js"],
  "scripts": {
    "build": "pkg-utils build",
    "clean": "rimraf dist",
    "dev": "pkg-utils watch --strict",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/surjithctly/sanity-plugin-asset-source-screenshotone.git"
  },
  "keywords": [
    "sanity",
    "sanity-plugin",
    "url-screenshot"
  ],
  "author": "Surjith S M <mail@surjithctly.in>",
  "license": "MIT",
  "dependencies": {
    "@sanity/ui": "^2.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^6.0.0",
    "@types/react": "^18.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-sanity": "^7.0.0",
    "eslint-plugin-react": "^7.31.8",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "sanity": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "sanity": "^3.0.0"
  },
  "bugs": {
    "url": "https://github.com/surjithctly/sanity-plugin-asset-source-screenshotone/issues"
  },
  "homepage": "https://github.com/surjithctly/sanity-plugin-asset-source-screenshotone#readme",
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": false
  },
  "eslintConfig": {
    "parser": "sanipack/babel/eslint-parser",
    "extends": [
      "sanity",
      "sanity/react",
      "prettier"
    ],
    "ignorePatterns": [
      "dist/**/"
    ]
  }
}
